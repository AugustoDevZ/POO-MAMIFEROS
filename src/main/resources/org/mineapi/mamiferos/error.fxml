<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.mineapi.mamiferos.presentation.controller.ErrorController"
      alignment="CENTER"
      spacing="18"
      prefWidth="420"
      prefHeight="250"
      stylesheets="@app.css"
      styleClass="error-window">

    <padding>
        <Insets top="28" right="30" bottom="28" left="30"/>
    </padding>

    <Label
            text="⚠"
            styleClass="error-icon"/>

    <VBox alignment="CENTER" spacing="6">
        <Label
                fx:id="lblTitulo"
                text="Ha ocurrido un error"
                styleClass="error-title"/>

        <Label
                fx:id="lblMensaje"
                text="No se pudo completar la operación."
                wrapText="true"
                textAlignment="CENTER"
                styleClass="error-message"/>
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <Button
                text="Aceptar"
                onAction="#onAceptar"
                styleClass="error-button"/>
    </HBox>

</VBox>