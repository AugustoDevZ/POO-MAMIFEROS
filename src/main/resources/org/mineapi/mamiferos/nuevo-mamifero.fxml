<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="org.mineapi.mamiferos.presentation.controller.NuevoMamiferoController"
        stylesheets="@app.css"
        styleClass="root">

    <!-- CABECERA -->

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="10"
                styleClass="header">

            <VBox
                    HBox.hgrow="ALWAYS"
                    spacing="3">

                <Label
                        text="NUEVO MAMÍFERO"
                        styleClass="title"/>

                <Label
                        text="Registra las características del animal"
                        styleClass="subtitle"/>

            </VBox>

            <Button
                    text="Cancelar"
                    onAction="#onCancelar"
                    styleClass="action-button"/>
            <Button
                    text="Random"
                    onAction="#onCreateRandom"
                    styleClass="action-button"/>
            <Button
                    fx:id="btnCrearMami"
                    text="Crear mamífero"
                    onAction="#onCrear"
                    styleClass="action-button"/>

        </HBox>
    </top>


    <!-- FORMULARIO -->

    <center>

        <ScrollPane
                fitToWidth="true"
                styleClass="mammal-scroll">

            <content>

                <VBox
                        spacing="22"
                        maxWidth="700"
                        styleClass="animal-content">

                    <!-- TIPO -->

                    <VBox spacing="10">

                        <Label
                                text="TIPO DE MAMÍFERO"
                                styleClass="section-title"/>

                        <GridPane
                                hgap="12"
                                vgap="12">

                            <Label
                                    text="Tipo"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"
                                    styleClass="form-label"/>

                            <ComboBox
                                    fx:id="cmbTipo"
                                    prefWidth="250"
                                    onAction="#onTipoChanged"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    styleClass="form-input"/>


                            <Label
                                    text="Animal"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"
                                    styleClass="form-label"/>

                            <ComboBox
                                    fx:id="cmbAnimal"
                                    prefWidth="250"
                                    onAction="#onAnimalChanged"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    styleClass="form-input"/>

                        </GridPane>

                    </VBox>


                    <!-- INFORMACIÓN GENERAL -->

                    <VBox
                            spacing="10"
                            styleClass="form-section">

                        <Label
                                text="INFORMACIÓN GENERAL"
                                styleClass="section-title"/>

                        <GridPane
                                hgap="12"
                                vgap="12">

                            <Label
                                    text="Nombre científico"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtNombreCientifico"
                                    promptText="Ej. Panthera tigris"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    styleClass="form-input"/>


                            <Label
                                    text="Hábitat"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtHabita"
                                    promptText="Ej. Selva"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    styleClass="form-input"/>


                            <Label
                                    text="Altura"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtAltura"
                                    promptText="Ej. 1.20"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"
                                    styleClass="form-input"/>


                            <Label
                                    text="Largo"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtLargo"
                                    promptText="Ej. 2.50"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"
                                    styleClass="form-input"/>


                            <Label
                                    text="Peso"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="4"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtPeso"
                                    promptText="Ej. 180.5"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="4"
                                    styleClass="form-input"/>


                            <Label
                                    text="Imagen de perfil"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="5"
                                    styleClass="form-label"/>

                            <HBox
                                    spacing="8"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="5">

                                <TextField
                                        fx:id="txtPathImagePerfil"
                                        promptText="Seleccione una imagen..."
                                        HBox.hgrow="ALWAYS"
                                        styleClass="form-input"/>

                                <Button
                                        text="Explorar"
                                        onAction="#onSeleccionarImagen"
                                        styleClass="header-button"/>
                            </HBox>

                        </GridPane>

                    </VBox>


                    <!-- FELINO -->

                    <VBox
                            fx:id="felinoSection"
                            spacing="10"
                            styleClass="form-section"
                            managed="false"
                            visible="false">

                        <Label
                                text="CARACTERÍSTICAS DEL FELINO"
                                styleClass="section-title"/>

                        <GridPane
                                hgap="12"
                                vgap="12">

                            <Label
                                    text="Tamaño de garras"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtTamanoGarras"
                                    promptText="Ej. 8.5"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    styleClass="form-input"/>


                            <Label
                                    text="Velocidad"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtVelocidad"
                                    promptText="Ej. 65"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    styleClass="form-input"/>

                            <Label
                                    fx:id="lblFelino"
                                    text="Raza"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtFelino"
                                    promptText="Ej. 8.5"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"
                                    styleClass="form-input"/>


                            <Label
                                    fx:id="lblFelino2"
                                    text="Velocidad"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtFelino2"
                                    promptText="Ej. 65"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"
                                    styleClass="form-input"/>

                        </GridPane>

                    </VBox>


                    <!-- CANINO -->

                    <VBox
                            fx:id="caninoSection"
                            spacing="10"
                            styleClass="form-section"
                            managed="false"
                            visible="false">

                        <Label
                                text="CARACTERÍSTICAS DEL CANINO"
                                styleClass="section-title"/>

                        <GridPane
                                hgap="12"
                                vgap="12">

                            <Label
                                    text="Color"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="0"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtColorCanino"
                                    promptText="Ej. Marrón"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="0"
                                    styleClass="form-input"/>


                            <Label

                                    text="Tamaño de colmillos"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="1"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtTamañoColmillosCanino"
                                    promptText="Ej. 4.5"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="1"
                                    styleClass="form-input"/>
                            <Label
                                    fx:id="lblCanino"
                                    text="Color"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="2"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtCanino"
                                    promptText="Ej. Marrón"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"
                                    styleClass="form-input"/>


                            <Label
                                    fx:id="lblCanino2"
                                    text="Tamaño de colmillos"
                                    GridPane.columnIndex="0"
                                    GridPane.rowIndex="3"
                                    styleClass="form-label"/>

                            <TextField
                                    fx:id="txtCanino2"
                                    promptText="Ej. 4.5"
                                    GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"
                                    styleClass="form-input"/>

                        </GridPane>

                    </VBox>


                    <!-- CAMPOS ESPECÍFICOS DEL ANIMAL -->



                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>